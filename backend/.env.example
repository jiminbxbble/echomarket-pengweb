# Salin file ini menjadi .env lalu isi nilainya. File .env JANGAN di-commit.

# Neon PostgreSQL (Dashboard Neon > Connection Details)
# URL pooled (ada "-pooler" di host) untuk aplikasi:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/echomarket?sslmode=require"
# URL direct (tanpa "-pooler") untuk prisma migrate:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/echomarket?sslmode=require"

# JWT - isi dengan string acak panjang (contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="1d"

# Origin frontend yang diizinkan CORS, pisahkan dengan koma
CORS_ORIGIN="http://localhost:5173"

PORT=3000

# Password akun admin hasil seed
SEED_ADMIN_PASSWORD="admin12345"

# LLM (Google Gemini: https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# Opsional fallback Groq (https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
